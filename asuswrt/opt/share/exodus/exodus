#!/bin/sh

# Exodus for Asuswrt-Merlin: transparent proxy with mihomo on entware
# there is no procd on asuswrt: the core is kept running by the supervise loop,
# the watch loop restores the rules, syncs wi-fi clients and runs the scheduled tasks

. "${EXODUS_OPT:-/opt}/share/exodus/lib/common.sh"
. "$LIB_DIR/firewall.sh"
. "$LIB_DIR/profile.sh"

usage() {
	cat <<-EOF
		Usage: exodus <command>

		  start | stop | restart | status   control the proxy
		  update_subscription <id>          download a subscription, the running core gets it when it is in use
		  hard_update                       remove downloaded providers, update the subscription and restart
		  apply                             apply the rules again
		  sync                              sync the clients of the chosen wi-fi networks
		  clear_logs                        clear logs exceeding the size limit
		  debug                             print the debug report
		  web start|stop|restart|status|url  control the Merlin Web Admin page
		  passwd                            explain where to change the Merlin password
	EOF
}

# secrets and the hwid are generated once, like uci-defaults on openwrt
ensure_config() {
	local secret password hwid
	[ -f "$CONFIG_PATH" ] || return 1
	secret=$(cfg_get .mixin.api_secret)
	password=$(cfg_get .mixin.password)
	hwid=$(cfg_get .config.hwid)
	if [ -z "$secret" ] || [ -z "$password" ] || [ -z "$hwid" ]; then
		[ -n "$secret" ] || secret=$(random_hex 8) || return 1
		[ -n "$password" ] || password=$(random_hex 8) || return 1
		[ -n "$hwid" ] || hwid=$(generate_hwid)
		cfg_update '.mixin.api_secret = $secret | .mixin.password = $password | .config.hwid = $hwid' \
			--arg secret "$secret" --arg password "$password" --arg hwid "$hwid"
	fi
}

core_env() {
	local nofile gomemlimit mem_kb
	# entware allows 1024 files per process, the core needs more, but too many hang the router
	case "$(uname -m)" in
		aarch64*) nofile=40000 ;;
		*) nofile=10000 ;;
	esac
	ulimit -n "$nofile" 2> /dev/null || ulimit -S -n "$nofile" 2> /dev/null
	# half of the ram by default, go does not see the limits of the router and gets killed by oom
	gomemlimit="$c_core_gomemlimit"
	if [ -z "$gomemlimit" ]; then
		mem_kb=$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo 2> /dev/null)
		[ -n "$mem_kb" ] && gomemlimit="$((mem_kb / 2048))MiB"
	fi
	[ "$gomemlimit" = "off" ] && gomemlimit=
	[ -n "$gomemlimit" ] && export GOMEMLIMIT="$gomemlimit"
	[ -f "$EXODUS_OPT/etc/ssl/certs/ca-certificates.crt" ] && export SSL_CERT_FILE="$EXODUS_OPT/etc/ssl/certs/ca-certificates.crt"
}

is_running() {
	pid_alive "$SUPERVISOR_PID_PATH"
}

# the ports of the rules are listened by the core
core_listening() {
	[ -n "$fw_redir_port" ] && [ "$fw_tcp_mode" = "redirect" ] && ! port_listening tcp "$fw_redir_port" && return 1
	[ -n "$fw_tproxy_port" ] && [ -n "$fw_tp_protos" ] && ! port_listening tcp "$fw_tproxy_port" && return 1
	[ -n "$fw_dns_port" ] && { [ "$fw_dns4" = 1 ] || [ "$fw_dns6" = 1 ]; } && ! port_listening udp "$fw_dns_port" && return 1
	return 0
}

supervise() {
	local core_pid
	prepare_files
	cfg_load
	core_env
	echo "$$" > "$SUPERVISOR_PID_PATH"
	trap 'supervise_stop' TERM INT
	while [ ! -f "$STOP_FLAG_PATH" ]; do
		"$PROG" -d "$RUN_DIR" >> "$CORE_LOG_PATH" 2>&1 &
		core_pid=$!
		echo "$core_pid" > "$CORE_PID_PATH"
		wait "$core_pid"
		[ -f "$STOP_FLAG_PATH" ] && break
		log "Core" "Exited unexpectedly, restart in 5 seconds."
		sleep 5
	done
	rm -f "$SUPERVISOR_PID_PATH" "$CORE_PID_PATH"
}

supervise_stop() {
	local pid i
	pid=$(cat "$CORE_PID_PATH" 2> /dev/null)
	if [ -n "$pid" ] && kill "$pid" 2> /dev/null; then
		i=0
		while kill -0 "$pid" 2> /dev/null && [ "$i" -lt 50 ]; do
			msleep 100
			i=$((i + 1))
		done
		kill -9 "$pid" 2> /dev/null
	fi
	rm -f "$SUPERVISOR_PID_PATH" "$CORE_PID_PATH"
	exit 0
}

start() {
	prepare_files
	if ! lock_acquire service 1200; then
		echo "another start or stop is running"
		return 1
	fi
	start_locked
	local ret=$?
	lock_release service
	return "$ret"
}

start_locked() {
	cfg_load
	if is_running; then
		log "App" "Already running."
		return 0
	fi
	log "App" "Start."
	if [ ! -x "$PROG" ] || [ ! -x "$YQ" ]; then
		log "App" "Core or yq is not executable, run the installer again."
		log "App" "Exit."
		return 1
	fi
	ensure_config
	cfg_load
	rm -f "$STOP_FLAG_PATH" "$STARTED_FLAG_PATH" "$FIREWALL_ENV_PATH"
	if ! prepare_profile; then
		log "App" "Exit."
		return 1
	fi
	if ! mixin_profile; then
		log "Mixin" "Mixin failed, check the mixin file and the profile."
		log "App" "Exit."
		return 1
	fi
	profile_json
	profile_params
	local proxy; proxy=0
	[ "$c_proxy_enabled" = 1 ] && proxy=1
	if [ "$proxy" = 1 ] && ! check_profile; then
		log "App" "Exit."
		return 1
	fi
	log "Profile" "Testing..."
	if "$PROG" -d "$RUN_DIR" -t >> "$CORE_LOG_PATH" 2>&1; then
		log "Profile" "Test passed."
	else
		log "Profile" "Test failed."
		log "Profile" "Please check the core log to find out the problem."
		log "App" "Exit."
		return 1
	fi
	log "Core" "Start."
	daemonize "$EXODUS" supervise
	if [ "$proxy" = 1 ]; then
		log "Proxy" "Enabled."
		fw_prepare
		fw_env
		# rules without the core would cut the internet, they wait for its ports
		local i; i=0
		while ! core_listening && [ "$i" -lt 60 ]; do
			msleep 500
			i=$((i + 1))
		done
		if ! core_listening; then
			log "Proxy" "The core does not listen its ports, the rules are applied when it does."
		elif lock_acquire firewall 100; then
			if fw_start; then
				log "Proxy" "Hijack successful."
			else
				log "Proxy" "Hijack failed, see the messages above."
			fi
			lock_release firewall
		fi
		if [ "$fw_v6" = 1 ] && [ "$fw_v6_nat" != 1 ]; then
			log "Proxy" "ip6tables has no nat table, IPv6 DNS hijack and IPv6 TCP redirect are not available."
		fi
		if [ "$p_ipv6" = 1 ] && [ "$fw_v6" != 1 ]; then
			log "Proxy" "No global IPv6 address, IPv6 rules are skipped."
		fi
	else
		log "Proxy" "Disabled."
	fi
	touch "$STARTED_FLAG_PATH"
	daemonize "$EXODUS" watch
	return 0
}

stop() {
	prepare_files
	if ! lock_acquire service 1200; then
		echo "another start or stop is running"
		return 1
	fi
	cfg_load
	touch "$STOP_FLAG_PATH"
	if pid_alive "$WATCH_PID_PATH"; then
		kill "$(cat "$WATCH_PID_PATH")" 2> /dev/null
	fi
	# the killed watcher removes its pid file too, the two removals may race
	rm -f "$WATCH_PID_PATH" 2> /dev/null
	# rules go first, traffic must not wait for a stopped core
	lock_acquire firewall 100
	fw_clean
	lock_release firewall
	local pid i
	if pid_alive "$SUPERVISOR_PID_PATH"; then
		pid=$(cat "$SUPERVISOR_PID_PATH")
		kill "$pid" 2> /dev/null
		i=0
		while kill -0 "$pid" 2> /dev/null && [ "$i" -lt 70 ]; do
			msleep 100
			i=$((i + 1))
		done
		kill -9 "$pid" 2> /dev/null
	fi
	if pid_alive "$CORE_PID_PATH"; then
		kill -9 "$(cat "$CORE_PID_PATH")" 2> /dev/null
	fi
	rm -f "$SUPERVISOR_PID_PATH" "$CORE_PID_PATH" "$STARTED_FLAG_PATH" "$FIREWALL_ENV_PATH"
	if [ "$c_log_clear_at_stop" = 1 ]; then
		: > "$APP_LOG_PATH"
		: > "$CORE_LOG_PATH"
		log "Log" "Logs are cleared due to clear at stop is enabled."
	fi
	lock_release service
}

status() {
	if is_running; then
		echo "running"
		return 0
	fi
	echo "stopped"
	return 1
}

# user scripts of asuswrt-merlin in /jffs/scripts, the installer adds a line to each of them:
# firewall-start and nat-start run after the firmware restored its tables without the rules of exodus,
# unmount runs before a disk is unmounted, $2 is its mount point
hook() {
	case "$1" in
		firewall|nat)
			[ -f "$STARTED_FLAG_PATH" ] || return 0
			fw_env || return 0
			# until the core listens the rules would cut the traffic, the watch loop applies them later
			core_listening || return 0
			lock_acquire firewall 100 || return 0
			fw_sets_local
			fw_apply
			fw_route_apply
			lock_release firewall
			;;
		unmount)
			# entware lives on the disk: the core goes away with it, the rules must not stay without the core
			[ -n "$2" ] || return 0
			case "$(readlink -f "$EXODUS_OPT")/" in
				"${2%/}"/*)
					stop
					web stop
					;;
			esac
			;;
	esac
}

watch() {
	local last minute tick
	prepare_files
	echo "$$" > "$WATCH_PID_PATH"
	trap 'rm -f "$WATCH_PID_PATH" 2> /dev/null; exit 0' TERM INT
	cfg_load
	# the minute of the start is skipped, a scheduled restart would repeat itself
	last=$(date +%Y%m%d%H%M)
	tick=0
	while [ ! -f "$STOP_FLAG_PATH" ]; do
		sleep 15 &
		wait $!
		[ -f "$STOP_FLAG_PATH" ] && break
		tick=$((tick + 1))
		if fw_env && lock_acquire firewall 50; then
			# the firmware may rebuild a table without calling a script, and the rules wait for the core after start
			if ! fw_intact && core_listening; then
				log "Proxy" "Rules are missing, apply them."
				fw_start
			elif [ $((tick % 2)) = 0 ]; then
				fw_sets_local
				fw_sets_mac
			fi
			lock_release firewall
		fi
		minute=$(date +%Y%m%d%H%M)
		[ "$minute" = "$last" ] && continue
		last="$minute"
		clear_logs
		# the subscription in use is downloaded again when its interval passes, in the background: it may take minutes
		if [ "${c_config_profile%%:*}" = "subscription" ] && subscription_due "${c_config_profile#*:}"; then
			daemonize "$EXODUS" auto_update
		fi
		if [ "$c_config_scheduled_restart" = 1 ] && [ -n "$c_config_scheduled_restart_cron" ] && cron_match "$c_config_scheduled_restart_cron"; then
			log "App" "Scheduled restart."
			daemonize "$EXODUS" restart
			break
		fi
	done
	rm -f "$WATCH_PID_PATH"
}

sync_sets() {
	[ -f "$STARTED_FLAG_PATH" ] || return 0
	fw_env || return 0
	lock_acquire firewall 100 || return 1
	fw_sets_local
	fw_sets_mac
	lock_release firewall
}

apply() {
	[ -f "$STARTED_FLAG_PATH" ] || return 0
	fw_env || return 0
	lock_acquire firewall 100 || return 1
	fw_start
	local ret=$?
	lock_release firewall
	return "$ret"
}

# logs live in ram, a log over the size limit (megabytes, 0 is no limit) is cleared, checked every minute
clear_logs() {
	local limit bytes
	limit="${c_log_max_size:-1}"
	case "$limit" in
		""|*[!0-9]*|0) return 0 ;;
	esac
	bytes=$((limit * 1024 * 1024))
	if [ -f "$APP_LOG_PATH" ] && [ "$(wc -c < "$APP_LOG_PATH")" -ge "$bytes" ]; then
		: > "$APP_LOG_PATH"
		log "Log" "App log is cleared, it exceeded the size limit."
	fi
	if [ -f "$CORE_LOG_PATH" ] && [ "$(wc -c < "$CORE_LOG_PATH")" -ge "$bytes" ]; then
		: > "$CORE_LOG_PATH"
		log "Log" "Core log is cleared, it exceeded the size limit."
	fi
}

hard_update() {
	# stop first, the core keeps providers in memory and stop may clear logs
	stop
	prepare_files
	cfg_load
	log "App" "Hard update."
	remove_provider_files
	# the start downloads a subscription only when its interval passed, a hard update downloads it anyway
	if [ "${c_config_profile%%:*}" = "subscription" ]; then
		update_subscription "${c_config_profile#*:}"
	fi
	start
}

# the subscription in use when its interval passed, started by the watch loop
auto_update() {
	prepare_files
	cfg_load
	[ -f "$STARTED_FLAG_PATH" ] || return 0
	[ "${c_config_profile%%:*}" = "subscription" ] || return 0
	subscription_due "${c_config_profile#*:}" || return 0
	refresh_subscription "${c_config_profile#*:}"
}

web() {
    . "$LIB_DIR/webui.sh"
    case "$1" in
        start) prepare_files; webui_mount && webui_cache_start ;;
        stop) webui_cache_stop; webui_unmount ;;
        restart) webui_cache_stop; webui_mount && webui_cache_start ;;
        status) if webui_status; then echo "registered: $(webui_url)"; else echo 'not registered'; return 1; fi ;;
        url) webui_url ;;
        event) . "$LIB_DIR/webui-api.sh"; webui_event "$2" "$3" ;;
        updates) . "$LIB_DIR/api.sh"; . "$LIB_DIR/webui-api.sh"; webui_updates_refresh ;;
        cache)
            lock_acquire webui-cache-loop 10 || return 1
            echo "$$" > "$WEBUI_DIR/cache.pid"
            trap '[ "$(cat "$WEBUI_DIR/cache.pid" 2>/dev/null)" != "$$" ] || rm -f "$WEBUI_DIR/cache.pid"; lock_release webui-cache-loop' EXIT
            trap 'exit 0' TERM INT
            trap '' HUP
            . "$LIB_DIR/webui-api.sh"
            webui_cache_loop ;;
        *) usage; return 1 ;;
    esac
}

set_password() {
    echo 'Exodus uses the Merlin Web Admin password. Change it in Administration -> System.'
}

debug() {
	cfg_load
	echo "# Exodus Debug Info"
	echo "## system"
	echo '```'
	router_info | jq -r '"\(.model // "") \(.os // "") \(.firmware // "")"' 2> /dev/null
	uname -a
	echo "exodus $(app_version), core $(core_version), yq $("$YQ" --version 2> /dev/null | awk '{ print $NF }')"
	echo "$("$FW_IPTABLES" -V 2> /dev/null | head -n 1) ($FW_IPTABLES), $("$FW_IPSET" -v 2> /dev/null | head -n 1)"
	echo "entware $(opkg print-architecture 2> /dev/null | awk '$2 != "all" && $2 != "noarch" { arch = $2 } END { print arch }'), /opt -> $(readlink -f "$EXODUS_OPT")"
	opkg list-installed 2> /dev/null | grep -E '^(curl|jq|ca-bundle) '
	echo "jffs scripts: $(nvram_get jffs2_scripts)"
	grep -H 'exodus' "$EXODUS_JFFS"/scripts/* 2> /dev/null
	echo '```'
	echo "## config"
	echo '```json'
	jq '
		def hide: if (. // "") != "" then "*" else . end;
		.mixin.api_secret |= hide
		| .mixin.password |= hide
		| .config.hwid |= hide
		| .subscriptions |= map(.url |= hide | .info_url |= hide)
		| .update.gh_proxy |= hide
		| .proxy.access_items |= map(if (startswith("mac:") or startswith("ip:") or startswith("ip6:")) then (split(":")[0] + ":*") else . end)
	' "$CONFIG_PATH" 2> /dev/null
	echo '```'
	echo "## profile"
	echo '```json'
	jq '
		def hide: map(
			with_entries(if (.key | IN("server", "servername", "sni", "port", "ports", "port-range", "uuid", "private-key", "public-key", "token", "username", "password")) then .value = "*" else . end)
		);
		(if has("secret") then .secret = "*" else . end)
		| (if has("authentication") then .authentication = [] else . end)
		| (if has("proxies") then .proxies |= hide else . end)
		| (if has("proxy-providers") then .["proxy-providers"] |= map_values(
			(if has("url") then .url = "*" else . end) | (if has("payload") then .payload |= hide else . end)
		) else . end)
	' "$PROFILE_JSON_PATH" 2> /dev/null
	echo '```'
	echo "## service"
	echo '```'
	echo "service: $(status)"
	echo "web ui: $(web status)"
	grep -v -E '^fw_items_(mac|ip4|ip6)=' "$FIREWALL_ENV_PATH" 2> /dev/null
	echo '```'
	echo "## ip rule"
	echo '```'
	ip -4 rule list
	ip -6 rule list 2> /dev/null
	echo '```'
	echo "## ip route"
	echo '```'
	ip -4 route list table "$TPROXY_TABLE" 2> /dev/null
	ip -6 route list table "$TPROXY_TABLE" 2> /dev/null
	echo '```'
	echo "## iptables"
	echo '```'
	local family ipt ipt_save ipt_restore table
	for family in 4 6; do
		fw_tools "$family"
		for table in nat mangle filter; do
			echo "# ${ipt##*/} $table"
			"$ipt_save" -t "$table" 2> /dev/null | grep -E '^:EXODUS|EXODUS|^:PControls|^-A (PREROUTING|INPUT|OUTPUT) ' | sed -E 's/(([0-9a-fA-F]{2}:){5})[0-9a-fA-F]{2}/\1**/g'
		done
	done
	echo '```'
	echo "## ipset"
	echo '```'
	"$FW_IPSET" list -t 2> /dev/null | awk '/^Name:/ { name = $2 } /^Type:/ { type = $2 } /^Number of entries:/ { print name, type, $4 }' | grep exodus
	echo '```'
	echo "## kernel modules"
	echo '```'
	grep -E '^(xt_|nf_tproxy|ip_set)' /proc/modules 2> /dev/null | cut -d ' ' -f 1 | tr '\n' ' '
	echo
	{ tr '\n' ' ' < /proc/net/ip_tables_targets; } 2> /dev/null
	echo
	{ tr '\n' ' ' < /proc/net/ip_tables_matches; } 2> /dev/null
	echo
	echo '```'
}

cmd="$1"
[ $# -gt 0 ] && shift
case "$cmd" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; start ;;
	status) status ;;
	boot)
		# boot from the init script: only with the autostart, the start delay does not block the other services
		prepare_files
		if [ "$(cfg_get .config.enabled)" = "true" ]; then
			delay=$(cfg_get .config.start_delay)
			if [ "${delay:-0}" -gt 0 ] 2> /dev/null; then
				log "App" "Start after $delay seconds."
				sleep "$delay"
			fi
			start
		else
			log "App" "Autostart is off."
		fi
		;;
	supervise) supervise ;;
	watch) watch ;;
	hook) hook "$@" ;;
	sync) sync_sets ;;
	apply) apply ;;
	update_subscription) prepare_files; cfg_load; refresh_subscription "$1" ;;
	auto_update) auto_update ;;
	hard_update) hard_update ;;
	clear_logs) prepare_files; cfg_load; clear_logs ;;
	debug) debug ;;
	web) web "$@" ;;
	passwd) set_password ;;
	init) prepare_files; ensure_config ;;
	*) usage; exit 1 ;;
esac
