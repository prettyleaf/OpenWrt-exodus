#!/bin/sh

# Exodus for MikroTik: transparent proxy with mihomo in a container of RouterOS
# the container runs "exodus container" under tini: the web ui, the autostart and the forwarding of the web ui in routeros
# the core is kept running by the supervise loop, the watch loop keeps the rules of routeros and syncs wi-fi clients

. "${EXODUS_OPT:-/opt}/share/exodus/lib/common.sh"
. "$LIB_DIR/firewall.sh"
. "$LIB_DIR/profile.sh"

usage() {
	cat <<-EOF
		Usage: exodus <command>

		  start | stop | restart | status   control the proxy
		  update_subscription <id>          download a subscription, the running core gets it when it is in use
		  hard_update                       remove downloaded providers, update the subscription and restart
		  apply                             apply the rules again, in the container and in routeros
		  sync                              sync the clients of the chosen wi-fi points with routeros
		  routeros                          check the connection to the rest api of routeros
		  forward                           forward the web ui from the addresses of the router again
		  clear_logs                        clear logs exceeding the size limit
		  debug                             print the debug report
		  web start|stop|restart            control the web ui
		  passwd                            set the password of the web ui
		  container                         the entrypoint of the container
	EOF
}

# a new install gets the config and the mixin file of the image; an old config gets the new options with their defaults,
# the values of the user win and options removed from exodus are dropped
init_config() {
	mkdir -p "$HOME_DIR"
	[ -f "$MIXIN_FILE_PATH" ] || cp -f "$DEFAULTS_DIR/mixin.yaml" "$MIXIN_FILE_PATH"
	if [ ! -f "$CONFIG_PATH" ]; then
		cp -f "$DEFAULTS_DIR/config.json" "$CONFIG_PATH"
		chmod 600 "$CONFIG_PATH"
		return 0
	fi
	lock_acquire config || return 1
	if jq -s '
		def known($user):
			if type == "object" then
				if ($user | type) == "object" then with_entries(.key as $k | if ($user | has($k)) then .value |= known($user[$k]) else . end) else . end
			else $user end;
		.[1] as $user | .[0] | known($user)' "$DEFAULTS_DIR/config.json" "$CONFIG_PATH" > "$CONFIG_PATH.new" 2> /dev/null && [ -s "$CONFIG_PATH.new" ]; then
		mv -f "$CONFIG_PATH.new" "$CONFIG_PATH"
	else
		rm -f "$CONFIG_PATH.new"
		echo "warning: the config is not valid json, it is kept as is"
	fi
	chmod 600 "$CONFIG_PATH"
	lock_release config
}

# secrets and the hwid are generated once, like uci-defaults on openwrt
ensure_config() {
	local secret password hwid
	[ -f "$CONFIG_PATH" ] || return 1
	secret=$(cfg_get .mixin.api_secret)
	password=$(cfg_get .mixin.password)
	hwid=$(cfg_get .config.hwid)
	if [ -z "$secret" ] || [ -z "$password" ] || [ -z "$hwid" ]; then
		[ -n "$secret" ] || secret=$(random_hex 8)
		[ -n "$password" ] || password=$(random_hex 8)
		[ -n "$hwid" ] || hwid=$(generate_hwid)
		cfg_update '.mixin.api_secret = $secret | .mixin.password = $password | .config.hwid = $hwid' \
			--arg secret "$secret" --arg password "$password" --arg hwid "$hwid"
	fi
	# since 1.29.0: subscriptions with the old default user agent get the user agent of exodus
	# once, the old one stays a choice for providers whose response rules do not know exodus yet
	if [ "$(cfg_get .config.user_agent_migrated)" != "true" ]; then
		cfg_update '.subscriptions |= map(if .user_agent == "Mihomo/Exodus v{version}" then .user_agent = "Exodus/{version} {platform}" else . end) | .config.user_agent_migrated = true'
	fi
}

# the environment of the container from /container/envs: the rest api of routeros, the gh-proxy, the password of the web ui
# the web ui runs its scripts without it, so the values go to the config
container_env() {
	local password
	if [ -n "$ROS_URL$ROS_USER$ROS_PASSWORD$ROS_LAN_LIST" ]; then
		cfg_update '
			.routeros.url = (if $url != "" then $url else .routeros.url end)
			| .routeros.username = (if $user != "" then $user else .routeros.username end)
			| .routeros.password = (if $password != "" then $password else .routeros.password end)
			| .routeros.lan_list = (if $lan != "" then $lan else .routeros.lan_list end)' \
			--arg url "$ROS_URL" --arg user "$ROS_USER" --arg password "$ROS_PASSWORD" --arg lan "$ROS_LAN_LIST"
	fi
	if [ -n "$GH_PROXY" ]; then
		cfg_update '.update.gh_proxy = $proxy' --arg proxy "${GH_PROXY%/}"
	fi
	if [ ! -f "$AUTH_PATH" ]; then
		if [ -n "$PASSWORD" ]; then
			printf '%s\n' "$PASSWORD" | set_password > /dev/null
		else
			password=$(random_hex 6)
			printf '%s\n' "$password" | set_password > /dev/null
			log "App" "No password of the web UI is given, the generated one is $password, change it in Settings."
		fi
	fi
}

core_env() {
	local nofile gomemlimit mem_kb limit
	case "$(uname -m)" in
		aarch64*|x86_64) nofile=40000 ;;
		*) nofile=10000 ;;
	esac
	ulimit -n "$nofile" 2> /dev/null || ulimit -S -n "$nofile" 2> /dev/null
	# half of the ram by default, or of the memory limit of the container; go does not see the limits and gets killed by oom
	gomemlimit="$c_core_gomemlimit"
	if [ -z "$gomemlimit" ]; then
		mem_kb=$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo 2> /dev/null)
		limit=$(cat /sys/fs/cgroup/memory.max 2> /dev/null || cat /sys/fs/cgroup/memory/memory.limit_in_bytes 2> /dev/null)
		case "$limit" in
			""|*[!0-9]*) ;;
			*) [ -n "$mem_kb" ] && [ "$((limit / 1024))" -lt "$mem_kb" ] && mem_kb=$((limit / 1024)) ;;
		esac
		[ -n "$mem_kb" ] && gomemlimit="$((mem_kb / 2048))MiB"
	fi
	[ "$gomemlimit" = "off" ] && gomemlimit=
	[ -n "$gomemlimit" ] && export GOMEMLIMIT="$gomemlimit"
	[ -f /etc/ssl/certs/ca-certificates.crt ] && export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
}

is_running() {
	pid_alive "$SUPERVISOR_PID_PATH"
}

# the ports of the rules are listened by the core
core_listening() {
	[ -n "$fw_redir_port" ] && [ "$fw_tcp_mode" = "redirect" ] && ! port_listening tcp "$fw_redir_port" && return 1
	[ -n "$fw_tproxy_port" ] && [ -n "$fw_tp_protos" ] && ! port_listening tcp "$fw_tproxy_port" && return 1
	[ -n "$fw_dns_port" ] && [ "$fw_dns" = 1 ] && ! port_listening udp "$fw_dns_port" && return 1
	return 0
}

supervise() {
	local core_pid
	prepare_files
	cfg_load
	core_env
	echo "$$" > "$SUPERVISOR_PID_PATH"
	trap 'supervise_stop' TERM INT
	while [ ! -f "$STOP_FLAG_PATH" ]; do
		"$PROG" -d "$RUN_DIR" >> "$CORE_LOG_PATH" 2>&1 &
		core_pid=$!
		echo "$core_pid" > "$CORE_PID_PATH"
		wait "$core_pid"
		[ -f "$STOP_FLAG_PATH" ] && break
		log "Core" "Exited unexpectedly, restart in 5 seconds."
		sleep 5
	done
	rm -f "$SUPERVISOR_PID_PATH" "$CORE_PID_PATH"
}

supervise_stop() {
	local pid i
	pid=$(cat "$CORE_PID_PATH" 2> /dev/null)
	if [ -n "$pid" ] && kill "$pid" 2> /dev/null; then
		i=0
		while kill -0 "$pid" 2> /dev/null && [ "$i" -lt 50 ]; do
			msleep 100
			i=$((i + 1))
		done
		kill -9 "$pid" 2> /dev/null
	fi
	rm -f "$SUPERVISOR_PID_PATH" "$CORE_PID_PATH"
	exit 0
}

start() {
	prepare_files
	if ! lock_acquire service 1200; then
		echo "another start or stop is running"
		return 1
	fi
	start_locked
	local ret=$?
	lock_release service
	return "$ret"
}

start_locked() {
	cfg_load
	if is_running; then
		log "App" "Already running."
		return 0
	fi
	log "App" "Start."
	if [ ! -x "$PROG" ] || [ ! -x "$YQ" ]; then
		log "App" "Core or yq is not executable, update Exodus on the Updates page or take the image again."
		log "App" "Exit."
		return 1
	fi
	ensure_config
	cfg_load
	rm -f "$STOP_FLAG_PATH" "$STARTED_FLAG_PATH" "$FIREWALL_ENV_PATH"
	if ! prepare_profile; then
		log "App" "Exit."
		return 1
	fi
	if ! mixin_profile; then
		log "Mixin" "Mixin failed, check the mixin file and the profile."
		log "App" "Exit."
		return 1
	fi
	profile_json
	profile_params
	local proxy; proxy=0
	[ "$c_proxy_enabled" = 1 ] && proxy=1
	if [ "$proxy" = 1 ] && ! check_profile; then
		log "App" "Exit."
		return 1
	fi
	log "Profile" "Testing..."
	if "$PROG" -d "$RUN_DIR" -t >> "$CORE_LOG_PATH" 2>&1; then
		log "Profile" "Test passed."
	else
		log "Profile" "Test failed."
		log "Profile" "Please check the core log to find out the problem."
		log "App" "Exit."
		return 1
	fi
	log "Core" "Start."
	daemonize "$EXODUS" supervise
	if [ "$proxy" = 1 ]; then
		log "Proxy" "Enabled."
		fw_prepare
		fw_env
		# rules without the core would cut the internet, they wait for its ports
		local i; i=0
		while ! core_listening && [ "$i" -lt 60 ]; do
			msleep 500
			i=$((i + 1))
		done
		if ! core_listening; then
			log "Proxy" "The core does not listen its ports, the rules are applied when it does."
		elif lock_acquire firewall 300; then
			if fw_start; then
				log "Proxy" "Hijack successful."
			else
				log "Proxy" "Hijack failed, see the messages above, the rules are applied again every 30 seconds."
			fi
			lock_release firewall
		fi
		if [ "$p_ipv6" = 1 ] && [ "$fw_v6" != 1 ]; then
			log "Proxy" "The container has no IPv6 address or gateway, IPv6 is not proxied."
		fi
	else
		log "Proxy" "Disabled."
	fi
	touch "$STARTED_FLAG_PATH"
	daemonize "$EXODUS" watch
	return 0
}

stop() {
	prepare_files
	if ! lock_acquire service 1200; then
		echo "another start or stop is running"
		return 1
	fi
	cfg_load
	touch "$STOP_FLAG_PATH"
	if pid_alive "$WATCH_PID_PATH"; then
		kill "$(cat "$WATCH_PID_PATH")" 2> /dev/null
	fi
	# the killed watcher removes its pid file too, the two removals may race
	rm -f "$WATCH_PID_PATH" 2> /dev/null
	# rules go first, traffic must not wait for a stopped core
	lock_acquire firewall 300
	fw_clean
	lock_release firewall
	local pid i
	if pid_alive "$SUPERVISOR_PID_PATH"; then
		pid=$(cat "$SUPERVISOR_PID_PATH")
		kill "$pid" 2> /dev/null
		i=0
		while kill -0 "$pid" 2> /dev/null && [ "$i" -lt 70 ]; do
			msleep 100
			i=$((i + 1))
		done
		kill -9 "$pid" 2> /dev/null
	fi
	if pid_alive "$CORE_PID_PATH"; then
		kill -9 "$(cat "$CORE_PID_PATH")" 2> /dev/null
	fi
	rm -f "$SUPERVISOR_PID_PATH" "$CORE_PID_PATH" "$STARTED_FLAG_PATH" "$FIREWALL_ENV_PATH"
	if [ "$c_log_clear_at_stop" = 1 ]; then
		: > "$APP_LOG_PATH"
		: > "$CORE_LOG_PATH"
		log "Log" "Logs are cleared due to clear at stop is enabled."
	fi
	lock_release service
}

status() {
	if is_running; then
		echo "running"
		return 0
	fi
	echo "stopped"
	return 1
}

watch() {
	local last minute tick
	prepare_files
	echo "$$" > "$WATCH_PID_PATH"
	trap 'rm -f "$WATCH_PID_PATH" 2> /dev/null; exit 0' TERM INT
	cfg_load
	# the minute of the start is skipped, a scheduled restart would repeat itself
	last=$(date +%Y%m%d%H%M)
	tick=0
	while [ ! -f "$STOP_FLAG_PATH" ]; do
		sleep 15 &
		wait $!
		[ -f "$STOP_FLAG_PATH" ] && break
		tick=$((tick + 1))
		if fw_env && lock_acquire firewall 50; then
			# the rules wait for the core after start; routeros is asked every 30 seconds, the rules may be changed or turned off by netwatch
			if ! fw_nft_intact && core_listening; then
				log "Proxy" "Rules of the container are missing, apply them."
				fw_nft_start
			fi
			if [ $((tick % 2)) = 0 ]; then
				if ! fw_nft_ready; then
					# the rules of the container failed, a core that does not listen yet gets no rules anyway
					core_listening && fw_ros_hold
				elif ! fw_ros_intact && core_listening; then
					[ -f "$RUN_TMP/routeros_rules.err" ] || log "Proxy" "Rules of RouterOS are missing or changed, apply them."
					fw_ros_start
				else
					fw_ap_sync
				fi
			fi
			lock_release firewall
		fi
		minute=$(date +%Y%m%d%H%M)
		[ "$minute" = "$last" ] && continue
		last="$minute"
		clear_logs
		# the subscription in use is downloaded again when its interval passes, in the background: it may take minutes
		if [ "${c_config_profile%%:*}" = "subscription" ] && subscription_due "${c_config_profile#*:}"; then
			daemonize "$EXODUS" auto_update
		fi
		if [ "$c_config_scheduled_restart" = 1 ] && [ -n "$c_config_scheduled_restart_cron" ] && cron_match "$c_config_scheduled_restart_cron"; then
			log "App" "Scheduled restart."
			daemonize "$EXODUS" restart
			break
		fi
	done
	rm -f "$WATCH_PID_PATH"
}

sync_aps() {
	[ -f "$STARTED_FLAG_PATH" ] || return 0
	fw_env || return 0
	lock_acquire firewall 100 || return 1
	ros_load
	fw_ap_sync
	lock_release firewall
}

apply() {
	[ -f "$STARTED_FLAG_PATH" ] || return 0
	fw_env || return 0
	lock_acquire firewall 300 || return 1
	fw_start
	local ret=$?
	lock_release firewall
	return "$ret"
}

# logs are cleared when over the size limit (megabytes, 0 is no limit), checked every minute
clear_logs() {
	local limit bytes
	limit="${c_log_max_size:-1}"
	case "$limit" in
		""|*[!0-9]*|0) return 0 ;;
	esac
	bytes=$((limit * 1024 * 1024))
	if [ -f "$APP_LOG_PATH" ] && [ "$(wc -c < "$APP_LOG_PATH")" -ge "$bytes" ]; then
		: > "$APP_LOG_PATH"
		log "Log" "App log is cleared, it exceeded the size limit."
	fi
	if [ -f "$CORE_LOG_PATH" ] && [ "$(wc -c < "$CORE_LOG_PATH")" -ge "$bytes" ]; then
		: > "$CORE_LOG_PATH"
		log "Log" "Core log is cleared, it exceeded the size limit."
	fi
}

hard_update() {
	# stop first, the core keeps providers in memory and stop may clear logs
	stop
	prepare_files
	cfg_load
	log "App" "Hard update."
	remove_provider_files
	# the start downloads a subscription only when its interval passed, a hard update downloads it anyway
	if [ "${c_config_profile%%:*}" = "subscription" ]; then
		update_subscription "${c_config_profile#*:}"
	fi
	start
}

# the subscription in use when its interval passed, started by the watch loop
auto_update() {
	prepare_files
	cfg_load
	[ -f "$STARTED_FLAG_PATH" ] || return 0
	[ "${c_config_profile%%:*}" = "subscription" ] || return 0
	subscription_due "${c_config_profile#*:}" || return 0
	refresh_subscription "${c_config_profile#*:}"
}

web() {
	local port pid
	case "$1" in
		start)
			pid_alive "$WEB_PID_PATH" && return 0
			prepare_files
			port=$(cfg_get .web.port)
			if ! command -v lighttpd > /dev/null 2>&1; then
				echo "lighttpd is not installed"
				return 1
			fi
			sed -e "s|@PORT@|${port:-9099}|g" \
				-e "s|@WWW@|$SHARE_DIR/www|g" \
				-e "s|@RUN@|$RUN_TMP|g" \
				-e "s|@LOG@|$LOG_DIR|g" \
				-e "s|@OPT@|$EXODUS_OPT|g" \
				"$LIGHTTPD_CONF" > "$RUN_TMP/lighttpd.conf"
			lighttpd -f "$RUN_TMP/lighttpd.conf"
			;;
		stop)
			if pid_alive "$WEB_PID_PATH"; then
				pid=$(cat "$WEB_PID_PATH")
				kill "$pid" 2> /dev/null
			fi
			rm -f "$WEB_PID_PATH"
			;;
		restart)
			web stop
			sleep 1
			web start
			;;
		status)
			pid_alive "$WEB_PID_PATH" && echo "running" || echo "stopped"
			;;
		*)
			usage
			return 1
			;;
	esac
}

set_password() {
	local password confirm salt
	if [ -t 0 ]; then
		stty -echo 2> /dev/null
		printf 'New password of the web ui: '
		read -r password
		printf '\nRepeat: '
		read -r confirm
		stty echo 2> /dev/null
		echo
		if [ "$password" != "$confirm" ]; then
			echo "passwords do not match"
			return 1
		fi
	else
		read -r password
	fi
	if [ "${#password}" -lt 4 ]; then
		echo "the password is too short"
		return 1
	fi
	salt=$(random_hex 8)
	mkdir -p "$HOME_DIR"
	( umask 077; echo "$salt:$(printf '%s' "$salt$password" | sha256sum | cut -d ' ' -f 1)" > "$AUTH_PATH" )
	# sessions of the old password end
	rm -f "$SESSIONS_DIR"/* 2> /dev/null
	echo "password is set"
}

# the connection to routeros, for the shell of the container
routeros() {
	prepare_files
	if ros_check; then
		jq -r '"connected to \(.url) as \(.user), \(.identity // "") RouterOS \(.version // "")"' "$ROUTEROS_STATE_PATH"
		return 0
	fi
	jq -r '"no connection to \(.url) as \(.user): \(.error)"' "$ROUTEROS_STATE_PATH"
	return 1
}

debug() {
	local path
	cfg_load
	ros_load
	echo "# Exodus Debug Info"
	echo "## system"
	echo '```'
	router_info | jq -r '"\(.model // "") \(.board // "") RouterOS \(.version // "") \(.arch // "")"' 2> /dev/null
	uname -a
	echo "exodus $(app_version), core $(core_version), yq $("$YQ" --version 2> /dev/null | awk '{ print $NF }')"
	head -n 1 /etc/alpine-release 2> /dev/null | sed 's/^/alpine /'
	apk info -v 2> /dev/null | grep -E '^(curl|jq|lighttpd|nftables|iproute2|ca-certificates|tini)-[0-9]' | tr '\n' ' '
	echo
	echo '```'
	echo "## config"
	echo '```json'
	jq '
		def hide: if (. // "") != "" then "*" else . end;
		.mixin.api_secret |= hide
		| .mixin.password |= hide
		| .config.hwid |= hide
		| .routeros.password |= hide
		| .subscriptions |= map(.url |= hide | .info_url |= hide)
		| .update.gh_proxy |= hide
		| .proxy.access_items |= map(if (startswith("mac:") or startswith("ip:") or startswith("ip6:")) then (split(":")[0] + ":*") else . end)
	' "$CONFIG_PATH" 2> /dev/null
	echo '```'
	echo "## profile"
	echo '```json'
	jq '
		def hide: map(
			with_entries(if (.key | IN("server", "servername", "sni", "port", "ports", "port-range", "uuid", "private-key", "public-key", "token", "username", "password")) then .value = "*" else . end)
		);
		(if has("secret") then .secret = "*" else . end)
		| (if has("authentication") then .authentication = [] else . end)
		| (if has("proxies") then .proxies |= hide else . end)
		| (if has("proxy-providers") then .["proxy-providers"] |= map_values(
			(if has("url") then .url = "*" else . end) | (if has("payload") then .payload |= hide else . end)
		) else . end)
	' "$PROFILE_JSON_PATH" 2> /dev/null
	echo '```'
	echo "## service"
	echo '```'
	echo "service: $(status)"
	echo "web ui: $(web status)"
	grep -v -E '^fw_items_(mac|ip4|ip6)=' "$FIREWALL_ENV_PATH" 2> /dev/null
	echo '```'
	echo "## container network"
	echo '```'
	ip -o addr show 2> /dev/null | awk '{ print $2, $3, $4 }' | sed -E 's/(([0-9a-fA-F]{2}:){5})[0-9a-fA-F]{2}/\1**/g'
	ip -4 route show 2> /dev/null
	ip -6 route show 2> /dev/null | grep -v '^fe80'
	ip -4 rule list
	ip -6 rule list 2> /dev/null
	ip -4 route list table "$TPROXY_TABLE" 2> /dev/null
	ip -6 route list table "$TPROXY_TABLE" 2> /dev/null
	echo '```'
	echo "## nftables"
	echo '```'
	nft list table inet exodus 2> /dev/null
	nft list table inet exodus_nat 2> /dev/null
	echo '```'
	echo "## routeros"
	echo '```'
	ros_check > /dev/null
	jq -c 'del(.user)' "$ROUTEROS_STATE_PATH" 2> /dev/null
	echo "veth: $(ros_veth)"
	for path in $ROS_PROXY_PATHS4 $ROS_PROXY_PATHS6; do
		ros_json "$path?$(fw_ros_query "$path")" '[]' | jq -r --arg path "$path" --arg prefix "$ROS_COMMENT:" '
			.[]? | select((.comment // "") | startswith($prefix))
			| "/\($path) " + (del(.[".id"], .bytes, .packets, .comment) | to_entries | map(select(.value != "" and .value != "false")) | map("\(.key)=\(.value)") | join(" "))
		' 2> /dev/null | sed -E 's/(([0-9a-fA-F]{2}:){5})[0-9a-fA-F]{2}/\1**/g; s/(src-address=[0-9]+\.[0-9]+\.[0-9]+)\.[0-9]+/\1.*/g'
	done
	ros_json "routing/table?name=$ROS_TABLE" '[]' | jq -c '.[]? | {name, fib, disabled}' 2> /dev/null
	ros_json 'ip/firewall/filter?.proplist=chain,action,disabled,dynamic' '[]' | jq -r '.[]? | select(.action == "fasttrack-connection") | "fasttrack: chain=\(.chain) disabled=\(.disabled) dynamic=\(.dynamic)"' 2> /dev/null
	echo '```'
	echo "## kernel"
	echo '```'
	nft -v 2> /dev/null
	echo "tproxy of nftables: $(printf 'table inet exodus_test { chain c { type filter hook prerouting priority mangle; meta nfproto ipv4 meta l4proto udp tproxy ip to :1 } }\n' | nft -c -f - > /dev/null 2>&1 && echo "tproxy ok" || echo "tproxy failed")"
	echo '```'
}

# the entrypoint of the container: tini is the first process, it passes the signals of /container/stop here
container() {
	local pause
	prepare_files
	if [ -n "$TZ" ] && [ -f "/usr/share/zoneinfo/$TZ" ]; then
		ln -sf "/usr/share/zoneinfo/$TZ" /etc/localtime 2> /dev/null
	fi
	# the processes of the previous run of the container are gone, their files are not
	rm -f "$SUPERVISOR_PID_PATH" "$CORE_PID_PATH" "$WATCH_PID_PATH" "$WEB_PID_PATH" "$STARTED_FLAG_PATH" "$STOP_FLAG_PATH" \
		"$FIREWALL_ENV_PATH" "$ROUTER_INFO_PATH" "$ROUTEROS_STATE_PATH" "$RUN_TMP/routeros_rules.err"
	rm -rf "${RUN_TMP:?}"/*.lock "${SESSIONS_DIR:?}"/*
	init_config
	container_env
	ensure_config
	log "App" "Container start, Exodus $(app_version)."
	web start
	trap 'container_stop' TERM INT
	daemonize "$EXODUS" boot
	# the connection to routeros and the forwarding of the web ui, while the container runs; a router that boots is asked more often
	while :; do
		pause=15
		if ros_check > /dev/null; then
			pause=60
			if lock_acquire firewall 100; then
				fw_ros_web
				lock_release firewall
			fi
		fi
		sleep "$pause" &
		wait $!
	done
}

container_stop() {
	trap '' TERM INT
	log "App" "Container stop."
	stop
	if lock_acquire firewall 100; then
		ros_load
		fw_ros_clean web ip/firewall/nat
		lock_release firewall
	fi
	web stop
	exit 0
}

cmd="$1"
[ $# -gt 0 ] && shift
case "$cmd" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; start ;;
	status) status ;;
	boot)
		# boot from the container: only with the autostart, the start delay does not block the web ui
		prepare_files
		if [ "$(cfg_get .config.enabled)" = "true" ]; then
			delay=$(cfg_get .config.start_delay)
			if [ "${delay:-0}" -gt 0 ] 2> /dev/null; then
				log "App" "Start after $delay seconds."
				sleep "$delay"
			fi
			start
		else
			log "App" "Autostart is off."
		fi
		;;
	supervise) supervise ;;
	watch) watch ;;
	sync) sync_aps ;;
	apply) apply ;;
	routeros) routeros ;;
	forward)
		# the web ui on the addresses of the router after a change of the ports
		prepare_files
		if ros_check > /dev/null && lock_acquire firewall 100; then
			fw_ros_web
			lock_release firewall
		fi
		;;
	update_subscription) prepare_files; cfg_load; refresh_subscription "$1" ;;
	auto_update) auto_update ;;
	hard_update) hard_update ;;
	clear_logs) prepare_files; cfg_load; clear_logs ;;
	debug) debug ;;
	web) web "$@" ;;
	passwd) set_password ;;
	init) prepare_files; init_config; ensure_config ;;
	container) container ;;
	*) usage; exit 1 ;;
esac
